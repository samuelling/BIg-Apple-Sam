#include <windows.h>
#include "resource.h"

#include "version.h"

IDI_APP   ICON   "app.ico"
IDR_INDEX RCDATA "../index.html"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Big Apple Sam"
END

IDD_CONFIG DIALOGEX 0, 0, 262, 170
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Big Apple Sam"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "City code:", -1, 10, 12, 50, 10
    EDITTEXT        IDC_CODE, 64, 10, 188, 13, ES_AUTOHSCROLL
    LTEXT           "Copy the city code from the controls window in the web version to watch the same city. Leave it blank and the screen saver keeps a city of its own.", -1, 64, 27, 188, 27
    LTEXT           "Clock:", -1, 10, 63, 50, 10
    COMBOBOX        IDC_SPEED, 64, 61, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Display:", -1, 10, 82, 50, 10
    COMBOBOX        IDC_DISPLAY, 64, 80, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Always night", IDC_NIGHT, 64, 101, 80, 10
    AUTOCHECKBOX    "Cyberpunk mode", IDC_CYBER, 150, 101, 100, 10
    AUTOCHECKBOX    "Show what's happening in each apartment", IDC_CAPTIONS, 64, 116, 188, 10
    DEFPUSHBUTTON   "OK", IDOK, 148, 146, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 202, 146, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION BAS_VERSION_NUM
 PRODUCTVERSION BAS_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Sam Ling"
            VALUE "FileDescription", "Big Apple Sam screen saver"
            VALUE "FileVersion", BAS_VERSION_STR
            VALUE "InternalName", "BigAppleSam"
            VALUE "LegalCopyright", "Sam Ling"
            VALUE "OriginalFilename", "BigAppleSam.scr"
            VALUE "ProductName", "Big Apple Sam"
            VALUE "ProductVersion", BAS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
